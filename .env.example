# Copy to .env.local and fill in real values. Never commit real secrets.
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SECRET=

MONGODB_URI=mongodb://127.0.0.1:27017/electronics_shop
MONGODB_DB=electronics_shop

# Optional: DNS servers used for mongodb+srv SRV lookups (comma separated).
DNS_SERVERS=1.1.1.1,8.8.8.8

# Public origin used in metadata, robots.txt and sitemap.xml (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (admin product image uploads). Find these in the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
